    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": {
      "DATE": 10000,
      "DAY": 10001,
      "BT": 10002,
      "BATTERY": 10003,
      "SECOND_HAND": 10004,
      "HR_INDICATOR": 10005,
      "HOUR_MARKERS_COLOR": 10006,
      "MINUTE_MARKERS_COLOR": 10007,
      "CHARGING_MARKERS_COLOR": 10008,
      "HANDS_COLOR": 10009,
      "TIPS_COLOR": 10010,
      "SECOND_HAND_COLOR": 10011,
      "SECOND_TIP_COLOR": 10012,
      "CALENDAR_DAY_COLOR": 10013,
      "CORNER_TL": 10014,
      "CORNER_TR": 10015,
      "CORNER_BL": 10016,
      "CORNER_BR": 10017,
      "TEMP_UNIT": 10018,
      "THEME": 10019,
      "WEATHER_TEMP_MIN": 10020,
      "WEATHER_TEMP_MAX": 10021,
      "WEATHER_PRECIP": 10022,
      "FORECAST_START": 10023,
      "FORECAST_DATA": 10024,
      "CURRENT_TEMP_COLOR": 10025,
      "FUTURE_TEMP_COLOR": 10026,
      "BT_VIBRATE": 10027,
      "WEATHER_FETCHED_AT": 10028,
      "WEATHER_DAILY_UNTIL": 10029,
      "WEATHER_RAIN_UNTIL": 10030,
      "WEATHER_REQUEST": 10034,
