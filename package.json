    "resources": {
      "media": [
        {
          "type": "png",
          "name": "MENU_IMAGE",
          "file": "images/MenuImage_BW.png",
          "menuIcon": true
        }
      ]
    },
    "usesPermissions": [
      "Location",
      "Health"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:native": "python3 scripts/test-native.py",
    "test:bundle": "node scripts/check-bundle.js && node scripts/check-plugin-bundle.js"
  }
}
