{
  "name": "crisp-weather",
  "author": "nick1udwig",
  "version": "0.2.1",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
    "displayName": "Crisp Weather",
    "uuid": "1c4f5756-46a9-4df0-a820-48f3713007d3",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
